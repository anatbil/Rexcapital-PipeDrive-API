# Monday CRM API token (Profile → Developers → My access tokens).
# Keep this secret. Never commit your real .env or expose it to the frontend.
MONDAY_API_TOKEN=your_monday_api_token_here

# Board IDs (from board URL: .../boards/XXXXXXXX)
MONDAY_CONTACTOS_BOARD_ID=18424940106
MONDAY_ACUERDOS_BOARD_ID=18424940103

# Group ID for active deals on Acuerdos ("Acuerdos activos")
# From API: boards { groups { id title } } → usually "topics"
MONDAY_ACUERDOS_ACTIVOS_GROUP_ID=topics

# Column IDs on Contactos
MONDAY_CONTACTOS_EMAIL_COLUMN=email
MONDAY_CONTACTOS_PHONE_COLUMN=phone
# Optional — only if you also created these columns on Contactos
MONDAY_CONTACTOS_CIUDAD_INMUEBLE_COLUMN=
MONDAY_CONTACTOS_REGISTROS_PUBLICOS_COLUMN=

# Column IDs on Acuerdos (your 2 custom fields — same names as Pipedrive/form)
# Get via: boards(ids:[18424940103]) { columns { id title type } }
MONDAY_ACUERDOS_CIUDAD_INMUEBLE_COLUMN=
MONDAY_ACUERDOS_REGISTROS_PUBLICOS_COLUMN=

# Optional — connect/relation column linking Acuerdos → Contactos
MONDAY_ACUERDOS_CONTACT_COLUMN=
