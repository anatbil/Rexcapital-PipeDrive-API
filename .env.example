# Monday CRM API token (Profile → Developers → My access tokens).
# Keep this secret. Never commit your real .env or expose it to the frontend.
MONDAY_API_TOKEN=your_monday_api_token_here

# Board IDs (from board URL: .../boards/XXXXXXXX)
MONDAY_CONTACTOS_BOARD_ID=
MONDAY_ACUERDOS_BOARD_ID=

# Group ID for "Leads nuevos" on the Acuerdos board (pipeline stage)
MONDAY_LEADS_NUEVOS_GROUP_ID=

# Column IDs on Contactos
MONDAY_CONTACTOS_EMAIL_COLUMN=email
MONDAY_CONTACTOS_PHONE_COLUMN=phone
# Optional — only if you also created these columns on Contactos
MONDAY_CONTACTOS_UBICACION_COLUMN=
MONDAY_CONTACTOS_ESTADO_COLUMN=

# Column IDs on Acuerdos (your 3 custom fields)
MONDAY_ACUERDOS_UBICACION_COLUMN=
MONDAY_ACUERDOS_ESTADO_COLUMN=
MONDAY_ACUERDOS_MONTO_COLUMN=
# Optional — connect/relation column linking Acuerdos → Contactos
MONDAY_ACUERDOS_CONTACT_COLUMN=
