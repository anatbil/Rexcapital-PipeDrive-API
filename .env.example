# Monday CRM API token (Profile → Developers → My access tokens).
# Keep this secret. Never commit your real .env or expose it to the frontend.
MONDAY_API_TOKEN=your_monday_api_token_here

# Board IDs (from board URL: .../boards/XXXXXXXX)
MONDAY_CONTACTOS_BOARD_ID=18424940106
MONDAY_ACUERDOS_BOARD_ID=18424940103

# Group ID for active deals on Acuerdos ("Acuerdos activos")
MONDAY_ACUERDOS_ACTIVOS_GROUP_ID=topics

# Column IDs on Contactos (CRM defaults are contact_email / contact_phone)
MONDAY_CONTACTOS_EMAIL_COLUMN=contact_email
MONDAY_CONTACTOS_PHONE_COLUMN=contact_phone
MONDAY_CONTACTOS_CIUDAD_INMUEBLE_COLUMN=color_mm64xyps
MONDAY_CONTACTOS_REGISTROS_PUBLICOS_COLUMN=color_mm64g2ze

# Column IDs on Acuerdos
MONDAY_ACUERDOS_CIUDAD_INMUEBLE_COLUMN=color_mm64tbpa
MONDAY_ACUERDOS_REGISTROS_PUBLICOS_COLUMN=color_mm64t280

# board_relation column on Acuerdos linking to Contactos
MONDAY_ACUERDOS_CONTACT_COLUMN=deal_contact
